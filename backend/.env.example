# Backend-only env vars. The root .env.example is the source of truth;
# this file exists so the backend can be run on its own.

# Database — when running in Docker, "db" resolves to the postgres service.
# When running the backend on the host, change "db" to "localhost".
DATABASE_URL=postgresql+psycopg://codebase:codebase_dev_password@db:5432/codebase_ai

# CORS
FRONTEND_URL=http://localhost:5173

# LLM (Phase 3+)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Embeddings (Phase 3+)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536

# Reranker (Phase 3+)
RERANKER_PROVIDER=cohere
RERANKER_API_KEY=
RERANKER_MODEL=

# GitHub (Phase 2+)
GITHUB_TOKEN=

# Ingestion limits (Phase 2+)
MAX_REPO_SIZE_MB=200
MAX_FILE_SIZE_KB=512
MAX_FILES_PER_REPO=20000

# Logging
LOG_LEVEL=INFO
