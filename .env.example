# ============================================================
# CodeBase AI — root environment variables
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# ============================================================

# ---------- Database ----------
# Used by the FastAPI backend. Inside Docker, "db" resolves to the
# PostgreSQL service. When running the backend on the host machine,
# change "db" to "localhost".
POSTGRES_USER=codebase
POSTGRES_PASSWORD=codebase_dev_password
POSTGRES_DB=codebase_ai
DATABASE_URL=postgresql+psycopg://codebase:codebase_dev_password@db:5432/codebase_ai

# ---------- LLM (Phase 3+) ----------
# Provider-agnostic. Configure whichever model endpoint you use.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# ---------- Embeddings (Phase 3+) ----------
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536

# ---------- Reranker (Phase 3+) ----------
RERANKER_PROVIDER=cohere
RERANKER_API_KEY=
RERANKER_MODEL=

# ---------- GitHub (Phase 2+) ----------
# Optional. Public repos work without a token (rate limited).
# Add a token to raise the rate limit and (later) support private repos.
GITHUB_TOKEN=

# ---------- App ----------
# Public URL of the frontend, used for CORS.
FRONTEND_URL=http://localhost:5173
# Public URL of the backend, used by the frontend container if needed.
BACKEND_URL=http://localhost:8000

# ---------- Ingestion limits (Phase 2+) ----------
MAX_REPO_SIZE_MB=200
MAX_FILE_SIZE_KB=512
MAX_FILES_PER_REPO=20000
